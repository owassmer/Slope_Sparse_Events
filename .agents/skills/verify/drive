#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["playwright>=1.48,<2"]
# ///
"""drive: start the product in this checkout and use it as a user would.

The tool knows nothing about features. It starts the product's web viewer and a headless Chrome, offers the
actions any user has (open, click, type, press, send, run) and shows what is on screen (see).

Everything it starts runs with no route to a paid call: judgment-model requests are answered only from saved
responses (SLOPE_JEV_CACHE_ONLY=1), and the AWS, Claude and GitHub credentials are hidden from it.

State lives in .drive/ at the top of the checkout, so two worktrees can each run their own product.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

TEXT_LIMIT = 6000
CHROME_CANDIDATES = (
    os.environ.get("DRIVE_CHROME", ""),
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "google-chrome", "google-chrome-stable", "chromium", "chromium-browser",
)
HIDDEN_ENV = ("AWS_PROFILE", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "GH_TOKEN",
              "GITHUB_TOKEN", "ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN")


class DriveError(Exception):
    """An error the user can act on; its message says what to do next."""


# --- where things live ---------------------------------------------------------------------------------------

def top() -> Path:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if out.returncode != 0:
        raise DriveError("Not inside a git checkout of the product. cd into the repository and try again.")
    root = Path(out.stdout.strip())
    if not (root / "pyproject.toml").exists():
        raise DriveError(f"{root} has no pyproject.toml, so there is no product to start here.")
    return root


def home() -> Path:
    d = top() / ".drive"
    d.mkdir(exist_ok=True)
    return d


def state() -> dict:
    p = home() / "state.json"
    if not p.exists():
        raise DriveError("No product is running from this checkout. Run `drive start` first.")
    return json.loads(p.read_text())


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def guarded_env() -> dict[str, str]:
    """The product's environment: saved judgment answers only, and no cloud, Claude or GitHub credentials."""
    env = {k: v for k, v in os.environ.items() if k not in HIDDEN_ENV}
    d = home()
    for sub in ("no-claude", "no-gh"):
        (d / sub).mkdir(exist_ok=True)
    env.update({
        "SLOPE_JEV_CACHE_ONLY": "1",
        "AWS_CONFIG_FILE": os.devnull,
        "AWS_SHARED_CREDENTIALS_FILE": os.devnull,
        "AWS_EC2_METADATA_DISABLED": "true",
        "CLAUDE_CONFIG_DIR": str(d / "no-claude"),
        "GH_CONFIG_DIR": str(d / "no-gh"),
    })
    return env


def chrome_binary() -> str:
    for c in CHROME_CANDIDATES:
        if c and (Path(c).exists() or shutil.which(c)):
            return c if Path(c).exists() else shutil.which(c)
    raise DriveError("No Chrome found. Install Google Chrome or set DRIVE_CHROME to a Chrome/Chromium binary.")


# --- output --------------------------------------------------------------------------------------------------

def emit(obj: dict, as_json: bool) -> None:
    if as_json:
        print(json.dumps(obj, indent=1, default=str))
        return
    for k, v in obj.items():
        if k == "controls":
            print("controls (use the number with click/type/press):")
            runs: list[list[dict]] = []
            for c in v:  # alike neighbours (same kind, label and link) print as one line
                key = (c["kind"], c["label"], c.get("href"))
                if runs and (runs[-1][0]["kind"], runs[-1][0]["label"], runs[-1][0].get("href")) == key:
                    runs[-1].append(c)
                else:
                    runs.append([c])
            for run in runs:
                first, last = run[0], run[-1]
                if len(run) > 2:
                    print(f"  [{first['ref']}-{last['ref']}] {first['kind']}: {first['label'] or '(no label)'}"
                          f"  ({len(run)} alike)")
                    continue
                for c in run:
                    extra = " ".join(f"{a}={c[a]}" for a in ("value", "min", "max", "checked", "disabled", "href")
                                     if c.get(a) not in (None, "", False))
                    print(f"  [{c['ref']}] {c['kind']}: {c['label']}" + (f"  ({extra})" if extra else ""))
        elif k == "text":
            print("--- text on screen ---")
            print(v)
            print("--- end ---")
        elif isinstance(v, (list, dict)):
            if v:
                print(f"{k}:")
                for item in (v if isinstance(v, list) else [f"{a}: {b}" for a, b in v.items()]):
                    print(f"  {item}")
        else:
            print(f"{k}: {v}")


# --- the browser ---------------------------------------------------------------------------------------------

SEE_JS = r"""
(limit) => {
  const visible = (el) => {
    const r = el.getBoundingClientRect();
    const s = getComputedStyle(el);
    return (r.width > 0 || r.height > 0) && s.visibility !== 'hidden' && s.display !== 'none';
  };
  const sel = 'a[href], button, input, select, textarea, summary, [role=button], [role=tab], [role=link],'
            + ' [role=checkbox], [role=switch], [onclick], [tabindex]:not([tabindex="-1"])';
  const picked = new Set(Array.from(document.querySelectorAll(sel)).filter(visible));
  // anything else a pointer cursor marks as clickable, keeping only the outermost such element
  for (const el of document.querySelectorAll('body *')) {
    if (picked.has(el) || !visible(el)) continue;
    if (getComputedStyle(el).cursor !== 'pointer') continue;
    let p = el.parentElement, inside = false;
    while (p) { if (picked.has(p) || (p !== document.body && getComputedStyle(p).cursor === 'pointer')) { inside = true; break; } p = p.parentElement; }
    if (!inside) picked.add(el);
  }
  document.querySelectorAll('[data-drive-ref]').forEach(e => e.removeAttribute('data-drive-ref'));
  const label = (el) => {
    const lab = el.labels && el.labels.length ? el.labels[0].innerText : '';
    const t = (el.getAttribute('aria-label') || lab || el.innerText || el.textContent || el.getAttribute('title')
               || el.getAttribute('placeholder') || el.getAttribute('name') || el.id || '').replace(/\s+/g, ' ').trim();
    return t.length > 120 ? t.slice(0, 117) + '...' : t;
  };
  const controls = [];
  let n = 0;
  const ordered = Array.from(picked).sort((a, b) => a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
  for (const el of ordered) {
    n += 1;
    el.setAttribute('data-drive-ref', String(n));
    const tag = el.tagName.toLowerCase();
    const kind = tag === 'input' ? `input:${el.type}` : (el.getAttribute('role') || tag);
    const c = {ref: n, kind, label: label(el)};
    if ('value' in el && tag !== 'button' && tag !== 'li') c.value = String(el.value);
    if (tag === 'select') c.value = el.options[el.selectedIndex] ? el.options[el.selectedIndex].text : '';
    if (el.min) c.min = el.min; if (el.max) c.max = el.max;
    if (el.type === 'checkbox' || el.type === 'radio') c.checked = el.checked;
    if (el.disabled) c.disabled = true;
    if (tag === 'a') c.href = el.getAttribute('href');
    controls.push(c);
  }
  let text = (document.body ? document.body.innerText : '').replace(/[ \t]+/g, ' ').replace(/\n\s*\n+/g, '\n').trim();
  const total = text.length;
  if (limit > 0 && text.length > limit) text = text.slice(0, limit) + `\n... (${total - limit} more characters; use --all)`;
  return {title: document.title, url: location.href, text, controls};
}
"""


class Browser:
    """One tab in the Chrome that `drive start` launched, reached over its debugging port."""

    def __init__(self, st: dict):
        from playwright.sync_api import sync_playwright

        self.st = st
        self.pw = sync_playwright().start()
        try:
            self.b = self.pw.chromium.connect_over_cdp(f"http://127.0.0.1:{st['cdp_port']}")
        except Exception as e:
            self.pw.stop()
            raise DriveError(f"Chrome is not answering ({e}). Run `drive stop` and then `drive start`.") from e
        ctx = self.b.contexts[0]
        self.page = ctx.pages[0] if ctx.pages else ctx.new_page()
        self.errors: list[str] = []
        self.page.on("console", lambda m: self.errors.append(f"console {m.type}: {m.text} ({(m.location or {}).get('url', '')})")
                     if m.type in ("error", "warning") else None)
        self.page.on("pageerror", lambda e: self.errors.append(f"page error: {e}"))
        self.page.on("response", lambda r: self.errors.append(f"HTTP {r.status} {r.request.method} {r.url}")
                     if r.status >= 400 else None)

    def settle(self) -> None:
        try:
            self.page.wait_for_load_state("networkidle", timeout=60_000)
        except Exception:
            self.errors.append("the page was still loading after 60 s")
        self.page.wait_for_timeout(300)

    def see(self, limit: int) -> dict:
        out = self.page.evaluate(SEE_JS, limit)
        out["problems"] = list(self.errors)
        return out

    def element(self, target: str):
        if target.isdigit():
            loc = self.page.locator(f'[data-drive-ref="{target}"]')
            if loc.count() == 0:
                raise DriveError(f"No control [{target}] on the page now. Run `drive see` for the current numbers.")
            return loc.first
        loc = self.page.get_by_text(target, exact=False)
        if loc.count() == 0:
            raise DriveError(f"Nothing on the page shows the text {target!r}. Run `drive see` to read the page.")
        return loc.first

    def close(self) -> None:
        self.pw.stop()


def with_browser(fn, args) -> None:
    br = Browser(state())
    try:
        fn(br)
        br.settle()
        emit(br.see(0 if args.all else args.limit), args.json)
    finally:
        br.close()


# --- commands ------------------------------------------------------------------------------------------------

def cmd_start(args) -> None:
    root, d = top(), home()
    st_path = d / "state.json"
    if st_path.exists():
        st = json.loads(st_path.read_text())
        if alive(st["product_pid"]) and alive(st["chrome_pid"]):
            emit({"already running": st["url"], "hint": "use `drive stop` first to restart"}, args.json)
            return
    port, cdp = args.port or free_port(), free_port()
    product_cmd = ["uv", "run", "--frozen", "slope", "viewer", "--port", str(port), "--host", "127.0.0.1"]
    chrome_cmd = [chrome_binary(), "--headless=new", f"--remote-debugging-port={cdp}", "--no-first-run",
                  "--no-default-browser-check", f"--user-data-dir={d / 'chrome'}", "--window-size=1440,1000",
                  "about:blank"]
    if args.dry_run:
        emit({"would run": " ".join(product_cmd), "would open browser": " ".join(chrome_cmd[:2]), "in": root},
             args.json)
        return
    log = (d / "product.log").open("w")
    product = subprocess.Popen(product_cmd, cwd=root, env=guarded_env(), stdout=log, stderr=subprocess.STDOUT,
                               start_new_session=True)
    chrome = subprocess.Popen(chrome_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              start_new_session=True)
    url = f"http://127.0.0.1:{port}"
    st = {"url": url, "port": port, "cdp_port": cdp, "product_pid": product.pid, "chrome_pid": chrome.pid,
          "root": str(root), "log": str(d / "product.log"), "started": time.time()}
    st_path.write_text(json.dumps(st))
    deadline = time.time() + args.wait
    while time.time() < deadline:
        if product.poll() is not None:
            raise DriveError(f"The product exited during start. Read {d / 'product.log'}, fix it, then "
                             "`drive stop` and `drive start`.")
        try:
            urllib.request.urlopen(url + "/", timeout=2)
            emit({"started": url, "log": st["log"], "next": "drive open /"}, args.json)
            return
        except (urllib.error.URLError, ConnectionError, OSError):
            time.sleep(0.5)
    raise DriveError(f"The product did not answer within {args.wait} s. Read {st['log']}; then `drive stop`.")


def cmd_stop(args) -> None:
    d = home()
    p = d / "state.json"
    if not p.exists():
        emit({"stopped": "nothing was running"}, args.json)
        return
    st = json.loads(p.read_text())
    if args.dry_run:
        emit({"would stop": [st["product_pid"], st["chrome_pid"]]}, args.json)
        return
    for pid in (st["product_pid"], st["chrome_pid"]):
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            pass
    p.unlink()
    emit({"stopped": st["url"]}, args.json)


def cmd_status(args) -> None:
    try:
        st = state()
    except DriveError as e:
        emit({"running": False, "hint": str(e)}, args.json)
        return
    emit({"running": alive(st["product_pid"]) and alive(st["chrome_pid"]), "url": st["url"], "log": st["log"]},
         args.json)


def cmd_open(args) -> None:
    st = state()
    target = args.target if args.target.startswith("http") else st["url"] + "/" + args.target.lstrip("/")
    with_browser(lambda br: br.page.goto(target, wait_until="domcontentloaded", timeout=120_000), args)


def cmd_see(args) -> None:
    with_browser(lambda br: None, args)


def cmd_click(args) -> None:
    with_browser(lambda br: br.element(args.target).click(timeout=15_000), args)


def cmd_type(args) -> None:
    def act(br):
        el = br.element(args.target)
        kind = el.evaluate("e => e.tagName.toLowerCase() === 'input' ? e.type : e.tagName.toLowerCase()")
        if kind == "select":
            try:
                el.select_option(label=args.value, timeout=5_000)
            except Exception:
                el.select_option(value=args.value, timeout=5_000)
        elif kind in ("range", "number", "date", "color", "time"):
            el.evaluate("(e, v) => { e.value = v; e.dispatchEvent(new Event('input', {bubbles: true}));"
                        " e.dispatchEvent(new Event('change', {bubbles: true})); }", args.value)
        else:
            el.fill(args.value, timeout=15_000)
    with_browser(act, args)


def cmd_press(args) -> None:
    def act(br):
        if args.target:
            br.element(args.target).press(args.key, timeout=15_000)
        else:
            br.page.keyboard.press(args.key)
    with_browser(act, args)


def cmd_send(args) -> None:
    st = state()
    url = args.path if args.path.startswith("http") else st["url"] + "/" + args.path.lstrip("/")
    data = args.body.encode() if args.body else None
    req = urllib.request.Request(url, data=data, method=args.method.upper(),
                                 headers={"Content-Type": "application/json"} if data else {})
    t = time.time()
    try:
        with urllib.request.urlopen(req, timeout=args.timeout) as r:
            status, body, ctype = r.status, r.read().decode(errors="replace"), r.headers.get("content-type", "")
    except urllib.error.HTTPError as e:
        status, body, ctype = e.code, e.read().decode(errors="replace"), e.headers.get("content-type", "")
    if "json" in ctype and not args.all:
        try:
            body = json.dumps(json.loads(body), indent=1)
        except ValueError:
            pass
    if not args.all and len(body) > args.limit:
        body = body[:args.limit] + f"\n... ({len(body) - args.limit} more characters; use --all)"
    emit({"status": status, "content-type": ctype, "seconds": round(time.time() - t, 2), "body": body}, args.json)


def cmd_run(args) -> None:
    root = top()
    cmd = ["uv", "run", "--frozen", "slope", *args.args]
    if args.dry_run:
        emit({"would run": " ".join(cmd), "in": root, "environment": "saved judgment answers only; no cloud, "
              "Claude or GitHub credentials"}, args.json)
        return
    t = time.time()
    try:
        out = subprocess.run(cmd, cwd=root, env=guarded_env(), capture_output=True, text=True, timeout=args.timeout)
        code, text = out.returncode, (out.stdout + out.stderr)
    except subprocess.TimeoutExpired as e:
        code = "stopped"
        text = ((e.stdout or b"").decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or ""))
        text += f"\n(drive stopped it after {args.timeout} s; pass --timeout to allow longer)"
    if not args.all and len(text) > args.limit:
        text = text[:args.limit] + f"\n... ({len(text) - args.limit} more characters; use --all)"
    emit({"command": "slope " + " ".join(args.args), "exit": code, "seconds": round(time.time() - t, 1),
          "text": text}, args.json)


def main() -> int:
    ap = argparse.ArgumentParser(prog="drive", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="print JSON instead of text")
    common.add_argument("--limit", type=int, default=TEXT_LIMIT, help="characters of text to show (default %(default)s)")
    common.add_argument("--all", action="store_true", help="show all text, untruncated")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="command")
    _add = sub.add_parser
    sub.add_parser = lambda *a, **k: _add(*a, parents=[common], **k)

    s = sub.add_parser("start", help="start the product from this checkout on a free port, with a headless browser")
    s.add_argument("--port", type=int, default=0, help="port for the product (default: a free one)")
    s.add_argument("--wait", type=int, default=120, help="seconds to wait for it to answer (default %(default)s)")
    s.add_argument("--dry-run", action="store_true", help="say what would start, start nothing")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("stop", help="stop the product and the browser")
    s.add_argument("--dry-run", action="store_true", help="say what would stop, stop nothing")
    s.set_defaults(fn=cmd_stop)

    sub.add_parser("status", help="is a product running from this checkout, and where").set_defaults(fn=cmd_status)

    s = sub.add_parser("open", help="go to a path (e.g. /, /runs/<id>) or a URL, then show the page")
    s.add_argument("target")
    s.set_defaults(fn=cmd_open)

    sub.add_parser("see", help="show the page: its text, its numbered controls, and any errors").set_defaults(fn=cmd_see)

    s = sub.add_parser("click", help="click a control by its number from `see`, or the first thing showing a text")
    s.add_argument("target")
    s.set_defaults(fn=cmd_click)

    s = sub.add_parser("type", help="enter a value: text into a field, an option into a list, a value onto a slider")
    s.add_argument("target")
    s.add_argument("value")
    s.set_defaults(fn=cmd_type)

    s = sub.add_parser("press", help="press a key (Enter, ArrowRight, ...), on a control if given")
    s.add_argument("key")
    s.add_argument("target", nargs="?")
    s.set_defaults(fn=cmd_press)

    s = sub.add_parser("send", help="send an HTTP request to the product, as an API client would")
    s.add_argument("method", help="GET, POST, ...")
    s.add_argument("path")
    s.add_argument("body", nargs="?", help="JSON body")
    s.add_argument("--timeout", type=int, default=300)
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("run", help="run the product's command line: drive run -- <slope arguments>")
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.add_argument("--timeout", type=int, default=300, help="stop the command after this many seconds")
    s.add_argument("--dry-run", action="store_true", help="say what would run, run nothing")
    s.set_defaults(fn=cmd_run)

    args = ap.parse_args()
    if getattr(args, "args", None) and args.args[:1] == ["--"]:
        args.args = args.args[1:]
    try:
        args.fn(args)
        return 0
    except DriveError as e:
        print(f"drive: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
