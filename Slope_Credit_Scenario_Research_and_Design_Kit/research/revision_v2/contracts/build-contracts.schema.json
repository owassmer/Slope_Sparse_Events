    "LoanCashflowExport": {
      "type": "object",
      "properties": {
        "export_id": {
          "type": "string",
          "minLength": 1
        },
        "loan_id": {
          "type": "string",
          "minLength": 1
        },
        "borrower_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "currency": {
          "const": "USD"
        },
        "cashflow_type": {
          "enum": [
            "contractual",
            "conditional",
            "expected",
            "realized"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_computable",
            "not_run"
          ]
        },
        "scenario_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario_weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioWeight"
          },
          "minItems": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollectionRow"
          },
          "minItems": 0
        },
        "terminal_unresolved_principal": {
          "$ref": "#/$defs/EvidenceValue"
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "stakeholder_scope": {
          "enum": [
            "loan_asset_holder",
            "platform_net",
            "warehouse_equity"
          ]
        }
      },
      "required": [
        "export_id",
        "loan_id",
        "borrower_id",
        "decision_id",
        "as_of",
        "currency",
        "cashflow_type",
        "status",
        "scenario_id",
        "baseline_id",
        "scenario_weights",
        "rows",
        "terminal_unresolved_principal",
        "missing_inputs",
        "stakeholder_scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cashflow_type": {
                "const": "expected"
              }
            }
          },
          "then": {
            "properties": {
              "scenario_weights": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cashflow_type": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "scenario_weights": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_computable"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "maxItems": 0
              },
              "missing_inputs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
