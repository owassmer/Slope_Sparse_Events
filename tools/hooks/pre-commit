#!/usr/bin/env bash
# The definition (the files tools/roles/definitions lists) is committed only once the other family has judged the
# staged change HOLDS (scripts/review). Product changes otherwise come from the coordinator or from a worker's patch
# (Owen, October 28: the coordinator writes the code where the work holds the design, adopting Handoff's posture; the
# earlier rule here, product changes only through a worker, from October 7, is retired with it).
exec "$(git rev-parse --show-toplevel)/scripts/review" --check
