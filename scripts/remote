#!/usr/bin/env bash
# scripts/remote <name> [--attach <run id> | --with <dir>]    Run each line of run.txt on its own GitHub runner (.github/workflows/run.yml).
# Pushes the committed head to run/<name>, waits for the run, downloads every job's out/ to var/remote/<name>/, and
# writes .runs/remote-<name>-<time>.log ending "=== finished exit <n>", so the coordinator is told when it is done.
# Called by the coordinator; workers have no GitHub credentials. --attach follows a run already started. --with <dir>
# sends the committed head plus <dir>'s files (its run.txt replacing run.txt) as one commit on run/<name> only, so
# the outcome branch never carries them: how a walk wave carries its continuation states (scripts/walk-next).
set -euo pipefail
name="${1:?usage: scripts/remote <name> [--attach <run id>]}"
root="$(git rev-parse --show-toplevel)"; cd "$root"
with=""; [ "${2:-}" = --with ] && { with="$(cd "${3:?--with needs a folder}" && pwd)"; [ -f "$with/run.txt" ] || { echo "$with has no run.txt" >&2; exit 2; }; }
[ -n "$with" ] || [ -f run.txt ] || { echo "no run.txt: write one command per line first" >&2; exit 2; }
[ -n "$with" ] || git diff --quiet HEAD -- run.txt .github || { echo "commit run.txt first: the runners check out the commit" >&2; exit 2; }
if [ -n "$with" ]; then   # one commit on top of the head, carrying the folder, for the run branch alone
  tmp="$(mktemp -d)/wave"; git worktree add --quiet --detach "$tmp" HEAD
  (cd "$with" && tar -cf - .) | (cd "$tmp" && tar -xf -)
  git -C "$tmp" add -A -f . && git -C "$tmp" commit -q -m "Wave $name: $(grep -cv '^\s*\(#\|$\)' "$with/run.txt") lines" 
  wave_sha="$(git -C "$tmp" rev-parse HEAD)"; git worktree remove --force "$tmp"
fi
log=".runs/remote-$name-$(date +%Y%m%dT%H%M%S).log"; mkdir -p .runs
sha="${wave_sha:-$(git rev-parse HEAD)}"
{
  echo "=== remote run $name at ${sha:0:7}: $(grep -cv '^\s*\(#\|$\)' "${with:-.}/run.txt") jobs"
  echo "=== dispatched by session ${PI_SESSION_ID:-none}"
  echo "=== steerable (pid $BASHPID): not steerable; it follows a GitHub run"
  if [ "${2:-}" = --attach ]; then id="$3"; else
    git push -q --force origin "$sha:refs/heads/run/$name"
    for _ in $(seq 30); do
      id="$(gh run list --branch "run/$name" --commit "$sha" --workflow run.yml --limit 1 --json databaseId --jq '.[0].databaseId // empty')"
      [ -n "$id" ] && break; sleep 5
    done
  fi
  set +e
  repo="$(until gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null; do sleep 30; done)"
  echo "run https://github.com/$repo/actions/runs/$id"
  # Finished only when GitHub says the run is completed: a network error is retried, never read as an ending
  # (October 29: a dropped connection ended three watches with no finish line while their runs went on).
  while :; do
    state="$(gh run view "$id" --json status,conclusion --jq '.status + " " + (.conclusion // "")' 2>/dev/null)"
    case "$state" in completed*) break ;; esac
    sleep 60
  done
  status=1; [ "$state" = "completed success" ] && status=0
  dest="var/remote/$name"
  # every job's out-* artifact, or retried: a short download once fed a wave too few pieces (October 13)
  want="$(until gh run view "$id" --json jobs --jq '[.jobs[] | select(.name != "plan")] | length' 2>/dev/null; do sleep 30; done)"
  for _ in 1 2 3 4 5; do
    rm -rf "$dest"; mkdir -p "$dest"
    gh run download "$id" --pattern "out-*" --dir "$dest" > /dev/null 2>&1   # never the heavy-* artifacts
    got="$(find "$dest" -mindepth 1 -maxdepth 1 -type d -name 'out-*' | wc -l | tr -d ' ')"
    [ "$got" -ge "$want" ] && break
    echo "downloaded $got of $want job outputs; retrying"; sleep 30
  done
  until gh run view "$id" --json jobs --jq '.jobs[] | "\(.conclusion) \(.name)"' 2>/dev/null; do sleep 30; done
  set -e
  echo "outputs: $dest ($got of $want jobs)"
  echo "=== finished exit $status"
} > "$log" 2>&1 &
echo "remote run $name: $log"
