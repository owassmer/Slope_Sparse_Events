#!/usr/bin/env bash
# scripts/verify <outcome file>    A fresh verifier checks the outcome against the running product.
# Exits 0 when every line of its list works. Called by the coordinator.
#
# The verifier works in a throwaway checkout of this commit with tasks/ removed and no .env within reach; it
# writes its list and feature-map.md there, and this script copies both back and commits them.
set -euo pipefail
outcome="${1:?usage: scripts/verify outcomes/<NNN>.md}"
[ -f "$outcome" ] || { echo "scripts/verify: no outcome file $outcome" >&2; exit 2; }
VERIFIER="claude-cli/claude-opus-5-5:high"   # a different family from the worker; change it here and nowhere else

repo="$(git rev-parse --show-toplevel)"
outcome="$(cd "$(dirname "$outcome")" && pwd)/$(basename "$outcome")"; outcome="${outcome#"$repo"/}"
seen="${outcome%.md}.seen.md"
scratch="$(mktemp -d)/product"
git -C "$repo" worktree add --quiet --detach "$scratch" HEAD
cleanup() {
  (cd "$scratch" && .agents/skills/verify/drive stop >/dev/null 2>&1) || true
  git -C "$repo" worktree remove --force "$scratch" >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf "$scratch/tasks"
cp "$repo/$outcome" "$scratch/$outcome"                       # the outcome as the coordinator wrote it
[ -f "$repo/feature-map.md" ] && cp "$repo/feature-map.md" "$scratch/feature-map.md"
rm -f "$scratch/$seen"

# No route to a paid call: saved judgment answers only, no cloud or GitHub credentials.
export SLOPE_JEV_CACHE_ONLY=1 AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null GH_CONFIG_DIR="$(mktemp -d)"
unset AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN GH_TOKEN GITHUB_TOKEN

(cd "$scratch" && pi -p --no-session --approve --model "$VERIFIER" "Read AGENTS.md and $outcome. You did not
  write this change and must not read the diff, the git history or any file under tasks/. Use the verify skill
  to do, as a user, what the outcome says a user can do, then try the features that share a layer with what
  changed. Write $seen as a list, one line per behaviour you tried, each starting with WORKS or BROKEN, then
  what you did and what you saw. Update feature-map.md for each feature you reached. Do not commit.")

[ -f "$scratch/$seen" ] || { echo "scripts/verify: the verifier wrote no $seen" >&2; exit 1; }
cp "$scratch/$seen" "$repo/$seen"
cp "$scratch/feature-map.md" "$repo/feature-map.md"
git -C "$repo" add "$seen" feature-map.md
git -C "$repo" commit --quiet -m "Verify $(basename "${outcome%.md}") on $(git -C "$repo" rev-parse --short HEAD)" || true
grep -q '^WORKS' "$repo/$seen" && ! grep -q '^BROKEN' "$repo/$seen"
