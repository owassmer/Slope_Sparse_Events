#!/usr/bin/env bash
# scripts/work <task file>    A fresh worker makes one task true. Called by the coordinator from the outcome's branch.
#
# The worker gets its own workspace: a new git repository holding only the product (app/, tests/, cases/, the walk
# tools, the kit, the recorded runs), the reference specs, AGENTS.md, the case reveal files and a copy-on-write var/,
# with its own synced .venv, and no history, skills, factory outcomes, tasks, feature map or notebook. It runs inside
# the role sandbox (tools/roles/sandbox.ts): it can read only its workspace (plus the Python and Node installs) and
# change only the product there, and its only network is its own running product, which this script starts from the
# workspace's code (drive, with `drive restart` after it changes code). The task's text is its prompt. When it
# finishes, its changes to the product are applied to the outcome's branch as one commit; a change anywhere else fails
# the run and is not applied.
# While it runs, scripts/steer <run> "<message>" reaches the worker (tools/roles/run.mjs drives Pi in RPC mode), and
# scripts/steer <run> --stop ends it with nothing applied.
# The run streams to .runs/<run>.log and Pi's events to .runs/<run>.jsonl; the coordinator's session shows it live in a
# Ghostty split (tools/feed/feed, opened by .pi/extensions/factory-runs.ts), and scripts/watch prints the log.
set -euo pipefail
task="${1:?usage: scripts/work tasks/<id>-<n>.md}"
WORKER="openai-codex/gpt-6-astra:medium"     # change the worker model here and nowhere else
root="$(git rev-parse --show-toplevel)"; cd "$root"
[ -f "$task" ] || { echo "no task file $task; write it first" >&2; exit 2; }
task_text="$(cat "$task")"
# Nothing is delegated unread: the coordinator's delegation gate leaves word of each text its fresh reader read
# (.pi/extensions/delegation.ts). FACTORY_UNREAD=1 is for runs outside the coordinator's session (probes).
read_mark=".runs/read/$(printf '%s' "$task_text" | shasum -a 256 | cut -d' ' -f1)"
if [ -z "${FACTORY_RUN:-}" ] && [ -z "${FACTORY_UNREAD:-}" ] && [ ! -f "$read_mark" ]; then
  echo "$task has not been read by the fresh reader in this text: dispatch it on its own (scripts/work $task) so it is read first" >&2; exit 9
fi
KIT=Slope_Credit_Scenario_Research_and_Design_Kit
PRODUCT=(app tests cases tools/*.py "$KIT" runs/recorded)            # what the worker may change, with run.txt
git diff --quiet HEAD -- "${PRODUCT[@]}" || { echo "the product has uncommitted changes here; commit or clear them first" >&2; exit 2; }
SEES=("${PRODUCT[@]}" AGENTS.md pyproject.toml uv.lock .python-version Slope_*.md Jev_Pivot.md README.md)
[ -f run.txt ] && SEES+=(run.txt)
# Sources kept by earlier workers (tools/roles/worker.ts, source_keep), once there are any.
[ -n "$(git ls-tree --name-only HEAD research/sources)" ] && SEES+=(research/sources)

run="${FACTORY_RUN:-work-$(basename "${task%.md}")-$(date +%Y%m%dT%H%M%S)}"; mkdir -p .runs
# A dispatch never holds the caller: after the checks above, the run carries on in the background under the same
# name, and this prints where its log is (the coordinator is told when it finishes).
if [ -z "${FACTORY_RUN:-}" ]; then
  FACTORY_RUN="$run" nohup "$root/scripts/work" "$@" </dev/null >/dev/null 2>&1 &
  echo "run: .runs/$run.log"; exit 0
fi
log="$root/.runs/$run.log"
ws="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/slope-work.XXXXXX")" && pwd -P)"
echo "=== worker on $task ($WORKER) in $ws" > "$log"; echo "=== dispatched by session ${PI_SESSION_ID:-none}" >> "$log"
echo "=== steerable (pid $$): scripts/steer $run \"<message>\" (or --stop)" >> "$log"
on_err() { echo "=== finished exit $1 (${0##*/} stopped at line $2)" >> "$log"; }
trap 'on_err $? $LINENO' ERR
stop_product() { DRIVE_STATE="$ws/.drive/state.json" tools/drive/drive stop >/dev/null 2>&1 || true; pkill -f "$ws/" 2>/dev/null || true; }  # and anything else the worker left running there
# At most two workers run at once on this machine (each walk takes about a gigabyte); a third waits for a slot.
slot=""; locks=/private/tmp/slope-locks; mkdir -p "$locks"
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
until [ -n "$slot" ]; do
  for n in 1 2; do
    d="$locks/worker-$n"
    if mkdir "$d" 2>/dev/null; then echo $$ > "$d/pid"; slot="$d"; break; fi
    alive "$(cat "$d/pid" 2>/dev/null)" || rm -rf "$d"
  done
  [ -n "$slot" ] || { [ -n "${waited:-}" ] || echo "=== waiting for a worker slot (two run at once)" >> "$log"; waited=1; sleep 10; }
done
[ -z "${waited:-}" ] || echo "=== got a worker slot" >> "$log"
trap 'stop_product; rm -rf "$slot"' EXIT

# The workspace: the product and what explains it, as a fresh repository, with its own environment.
git archive HEAD -- "${SEES[@]}" | tar -x -C "$ws"
mkdir -p "$ws/outcomes" && cp outcomes/*.json "$ws/outcomes/" 2>/dev/null || true    # the viewer's reveal files
[ -d var ] && cp -cR var "$ws/var"                                                    # saved answers, snapshots, diagnostics
printf '.venv/\nvar/\n.drive/\n.tmp/\n__pycache__/\n.ruff_cache/\n.pytest_cache/\n' > "$ws/.gitignore"
(cd "$ws" && uv sync --frozen --offline -q) >> "$log" 2>&1
mkdir -p "$ws/.drive/bin" && cp tools/drive/drive "$ws/.drive/bin/drive" && cp tools/gates/gates "$ws/.drive/bin/gates"
git -C "$ws" init -q && git -C "$ws" add -A && \
  GIT_CONFIG_GLOBAL=/dev/null git -C "$ws" -c user.name=worker -c user.email=worker@slope.local commit -q -m base
base="$(git -C "$ws" rev-parse HEAD)"

# The running product, from the workspace's code, outside the sandbox.
DRIVE_STATE="$ws/.drive/state.json" tools/drive/drive start --workspace "$ws" >> "$log" 2>&1 || { echo "=== finished exit 4 (the product did not start)" >> "$log"; exit 4; }

node_dir="$(dirname "$(dirname "$(command -v node)")")"
uv_reads="$(dirname "$(command -v uv)"):$HOME/.local/share/uv/python"
ext=(); [[ "$WORKER" == claude-cli/* ]] && ext=(-e "$HOME/.pi/agent/extensions/claude-cli")
main_checkout="$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P)"
# The role's own exit status is handled below; the error trap would announce "finished" before the run had.
trap - ERR; set +e
(cd "$ws" && ROLE_WORKSPACE="$ws" ROLE_ALLOW_READ="$node_dir:$uv_reads" \
  ROLE_ALLOW_WRITE="app:tests:cases:tools:$KIT:runs/recorded:run.txt:var:.venv:.git:.tmp:.drive:.ruff_cache:.pytest_cache" \
  DRIVE_ROLE=worker DRIVE_STATE="$ws/.drive/state.json" UV_FROZEN=1 UV_OFFLINE=1 UV_NO_SYNC=1 SLOPE_JEV_CACHE_ONLY=1 FACTORY_ENV_FILE="$main_checkout/.env" \
  GIT_AUTHOR_NAME=worker GIT_AUTHOR_EMAIL=worker@slope.local GIT_COMMITTER_NAME=worker GIT_COMMITTER_EMAIL=worker@slope.local \
  node "$root/tools/roles/run.mjs" --inbox "$root/.runs/$run.steer" --prompt "You are the worker. Make this task true in the running product (drive --help shows how to use it), then commit, then report.

$task_text" -- \
  pi --mode rpc --no-session --no-extensions --no-skills --no-context-files --no-prompt-templates \
    "${ext[@]}" -e "$root/tools/roles/sandbox.ts" -e "$root/tools/roles/worker.ts" --tools read,bash,edit,write,report,web_search,web_fetch,source_keep --model "$WORKER" \
    --append-system-prompt "$ws/AGENTS.md" 2>> "$log") | tee "$root/.runs/$run.jsonl" | scripts/watch --render >> "$log"
status=${PIPESTATUS[0]}; set -e; trap 'on_err $? $LINENO' ERR
# Stopped by the coordinator (scripts/steer --stop): nothing it did is applied.
if [ "$status" -eq 7 ]; then
  echo "=== stopped by the coordinator; nothing applied (workspace kept at $ws)" >> "$log"
  echo "=== finished exit 7" >> "$log"; exit 7
fi
# Pi exits 0 even when the model failed (a usage limit, for one); a run whose last answer is a model error did not do its work.
if [ "$status" -eq 0 ] && tail -n 20 "$root/.runs/$run.jsonl" | grep -q '"stopReason":"error"'; then status=5; echo "=== the model failed; see the error above" >> "$log"; fi

# The worker's report (tools/roles/worker.ts) goes in the log, where the coordinator's finish notice reads it.
if [ -f "$ws/.tmp/report.json" ]; then
  { echo "=== report"; node -e 'const r=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")); for (const k of ["changed","departures","found"]) console.log(k + ":\n" + String(r[k] ?? "").trim() + "\n")' "$ws/.tmp/report.json"; echo "=== end of report"; } >> "$log"
else
  echo "=== no report filed" >> "$log"
  [ "$status" -eq 0 ] && status=8
fi

# Its product changes come back to the outcome's branch; anything else is refused.
git -C "$ws" add -A
# var/ is the worker's data, not product: it always comes back beside the checkout's own, and never counts as a change.
[ -d "$ws/var" ] && rsync -a "$ws/var/" var/ 2>/dev/null || true
changed="$(git -C "$ws" diff --cached --name-only "$base" | grep -v '^var/' || true)"
outside="$(printf '%s\n' "$changed" | grep -v -e '^app/' -e '^tests/' -e '^cases/' -e '^tools/[^/]*\.py$' -e "^$KIT/" -e '^runs/recorded/' -e '^research/sources/' -e '^run\.txt$' | grep -v '^$' || true)"
if [ -n "$outside" ]; then
  echo "=== refused: changes outside the product, nothing applied (workspace kept at $ws):" >> "$log"
  printf '%s\n' "$outside" >> "$log"
  echo "=== finished exit 3" >> "$log"; exit 3
fi
if [ -n "$changed" ]; then
  mkdir -p "$ws.tmp" && git -C "$ws" diff --cached --binary "$base" -- . ":!var" > "$ws.tmp/worker.patch"
  # Workers on one outcome can run at once from the same commit; their changes merge, and a real conflict stops here.
  if ! git apply --index --3way "$ws.tmp/worker.patch" >> "$log" 2>&1; then
    echo "=== conflict applying the worker's changes; nothing committed (patch kept at $ws.tmp/worker.patch, workspace kept)" >> "$log"
    git status --short -- "${PRODUCT[@]}" >> "$log"; echo "=== finished exit 6" >> "$log"; exit 6
  fi
  msg="$(git -C "$ws" log --format=%B "$base"..HEAD 2>/dev/null | sed '/^$/N;/^\n$/D')"
  # The repository's commit hook lets product changes in only from here (tools/hooks/pre-commit).
  SLOPE_WORKER_APPLY=1 git commit -q -m "${msg:-$(head -1 "$task" | sed 's/^# //')}" -m "Worker on $task."
  echo "=== applied to $(git branch --show-current) as $(git log -1 --format=%h)" >> "$log"
else
  echo "=== no product changes" >> "$log"
fi
echo "=== finished exit $status" >> "$log"
stop_product
[ "$status" -eq 0 ] && rm -rf "$ws" "$ws.tmp"
exit "$status"
