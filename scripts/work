#!/usr/bin/env bash
# scripts/work <task file>    A fresh worker makes one task true and commits. Called by the coordinator.
# The run streams to .runs/<run>.log as it happens (scripts/watch follows it; a Terminal window opens on it unless
# FACTORY_WATCH=off); Pi's raw events are in .runs/<run>.jsonl.
set -euo pipefail
task="${1:?usage: scripts/work tasks/<NNN>-<n>.md}"
WORKER="claude-cli/claude-opus-5-5:medium"   # change the worker model here and nowhere else
# Temporarily Claude while the Codex plan is at its usage limit (6 Oct); the worker is openai-codex/gpt-6-astra:medium.
root="$(git rev-parse --show-toplevel)"; cd "$root"
[ -f "$task" ] || { echo "no task file $task; write it first" >&2; exit 2; }

# No route to a paid call: saved judgment answers only, no cloud or GitHub credentials.
export SLOPE_JEV_CACHE_ONLY=1 AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null GH_CONFIG_DIR="$(mktemp -d)"
unset AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN GH_TOKEN GITHUB_TOKEN

run="work-$(basename "${task%.md}")-$(date +%Y%m%dT%H%M%S)"; mkdir -p .runs
echo "=== worker on $task ($WORKER)" > ".runs/$run.log"; echo "run: .runs/$run.log"
[ "${FACTORY_WATCH:-window}" = off ] || scripts/watch --window "$run" >/dev/null 2>&1 || true
set +e
pi --mode json --no-session --approve --model "$WORKER" "Read AGENTS.md and $task. Make it true in the running
  product, then commit." | tee ".runs/$run.jsonl" | scripts/watch --render >> ".runs/$run.log"
status=${PIPESTATUS[0]}; set -e
.agents/skills/verify/drive stop >/dev/null 2>&1 || true   # a product the worker left running
echo "=== finished exit $status" >> ".runs/$run.log"
exit "$status"
