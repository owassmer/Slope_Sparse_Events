#!/usr/bin/env bash
# scripts/work <task file>    A fresh worker makes one task true and commits. Called by the coordinator.
set -euo pipefail
task="${1:?usage: scripts/work tasks/<NNN>-<n>.md}"
[ -f "$task" ] || { echo "scripts/work: no task file $task" >&2; exit 2; }
WORKER="openai-codex/gpt-6-astra:medium"     # change the worker model here and nowhere else

# No route to a paid call: saved judgment answers only, no cloud or GitHub credentials.
export SLOPE_JEV_CACHE_ONLY=1 AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null GH_CONFIG_DIR="$(mktemp -d)"
unset AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN GH_TOKEN GITHUB_TOKEN

pi -p --no-session --approve --model "$WORKER" "Read AGENTS.md and $task. Make it true in the running product,
  then commit."
